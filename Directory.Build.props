<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata (applies when IsPackable=true)">
    <Authors>Tom Bulatewicz</Authors>
    <Copyright>Copyright © Tom Bulatewicz</Copyright>
    <PackageProjectUrl>https://github.com/tombly/remarkable-api-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tombly/remarkable-api-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible builds and SourceLink">
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- SourceLink comes with the .NET SDK (8 and later); the old explicit 8.0.0 package pulled in
       Microsoft.Build.Tasks.Git 8.0.0 (GHSA-23fw-v26w-5fgq), which TreatWarningsAsErrors fails on. -->
</Project>
